<supplementary-material content-type="local-data" id="MOESM4" position="float" orientation="portrait"><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2024_46361_MOESM4_ESM.pdf" position="float" orientation="portrait"><?suppdata-name 41467_2024_46361_MOESM4_ESM.pdf?><?suppdata-size 3268466?><?suppdata-md5 1e2bf82e11a0a85e4da4afd3a0263da1?><?suppdata-image-server-status NEVER_LOAD?><?suppdata-mime-type application?><?suppdata-mime-sub-type pdf?><?suppdata-cloudpmc-urn urn:app:b362/10923782/1e2bf82e11a0/41467_2024_46361_MOESM4_ESM.pdf?><caption><p>Peer Review File</p></caption></media></supplementary-material>
<supplementary-material content-type="local-data" id="MOESM5" position="float" orientation="portrait"><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2024_46361_MOESM5_ESM.mp4" position="float" orientation="portrait"><?suppdata-name 41467_2024_46361_MOESM5_ESM.mp4?><?suppdata-size 785243?><?suppdata-md5 ef28abf9bd9beafd35a8af080595fd0f?><?suppdata-image-server-status NEVER_LOAD?><?suppdata-mime-type video?><?suppdata-mime-sub-type mp4?><?suppdata-cloudpmc-urn urn:app:b362/10923782/ef28abf9bd9b/41467_2024_46361_MOESM5_ESM.mp4?><caption><p>Supplementary Movie 1</p></caption></media></supplementary-material>
