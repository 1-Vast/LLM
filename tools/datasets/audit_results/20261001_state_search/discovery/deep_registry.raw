{"created": "2023-07-27T19:22:35.900940+00:00", "modified": "2023-07-29T02:27:02.174521+00:00", "id": 8114649, "conceptrecid": "8114648", "doi": "10.5281/zenodo.8114649", "conceptdoi": "10.5281/zenodo.8114648", "doi_url": "https://doi.org/10.5281/zenodo.8114649", "metadata": {"title": "Deep model predictive control of gene expression in thousands of single cells", "doi": "10.5281/zenodo.8114649", "publication_date": "2023-07-07", "description": "<p>Experimental data, training datasets, and trained models for our study on deep model predictive control of gene expression in bacteria. This data can be used to reproduce our results and figures.</p>\n\n<p>See our preprint here: <a href=\"https://www.biorxiv.org/content/10.1101/2022.10.28.514305\">biorxiv.org/content/10.1101/2022.10.28.514305</a></p>\n\n<p>And our code repository here: <a href=\"https://gitlab.com/dunloplab/deepcellcontrol\">gitlab.com/dunloplab/deepcellcontrol</a></p>\n\n<p><strong>Contents:</strong></p>\n\n<ul>\n\t<li><em>datasets.zip</em>: Formatted experimental data used to train and validate fluorescence forecasting models.</li>\n\t<li><em>experiments.zip:</em> Processed data for all control experiments.</li>\n\t<li><em>misc.zip</em>: Files necessary to reproduce some figures or to exactly reproduce some of our results.</li>\n\t<li><em>models.zip</em>: Trained neural network models and associated files.</li>\n</ul>", "access_right": "open", "creators": [{"name": "Jean-Baptiste Lugagne", "affiliation": "Boston University", "orcid": "0000-0002-8374-6590"}, {"name": "Caroline M. Blassick", "affiliation": "Boston University", "orcid": "0000-0003-1941-7239"}, {"name": "Mary J. Dunlop", "affiliation": "Boston University", "orcid": "0000-0002-9261-8216"}], "keywords": ["Control theory", "Data-driven control", "Deep learning", "Synthetic biology", "Antibiotic resistance", "Optogenetics", "Mother machine", "Microfluidics", "Quantitative biology", "Bacteria", "Escherichia coli", "Single-cell microscopy"], "version": "1.0.0", "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "1R01AI102922-01A1", "internal_id": "10.13039/100000002::1R01AI102922-01A1", "funder": {"name": "National Institutes of Health", "doi": "10.13039/100000002", "acronym": "NIH"}, "title": "Feedback and Noise in a Multiple Antibiotic Resistance Circuit", "program": "NATIONAL_INSTITUTE_OF_ALLERGY_AND_INFECTIOUS_DISEASES"}, {"code": "1840990", "internal_id": "10.13039/100000001::1840990", "funder": {"name": "U.S. National Science Foundation", "doi": "10.13039/100000001", "acronym": "NSF"}, "title": "Graduate Research Fellowship (GRFP)", "program": "EHR/OAD"}, {"code": "2032357", "internal_id": "10.13039/100000001::2032357", "funder": {"name": "U.S. National Science Foundation", "doi": "10.13039/100000001", "acronym": "NSF"}, "title": "Single-cell feedback, optogenetics, and deep learning to control gene expression in bacteria", "program": "BIO/OAD"}], "communities": [{"id": "dunloplab"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "8114648"}}]}}, "title": "Deep model predictive control of gene expression in thousands of single cells", "links": {"self": "https://zenodo.org/api/records/8114649", "self_html": "https://zenodo.org/records/8114649", "preview_html": "https://zenodo.org/records/8114649?preview=1", "doi": "https://doi.org/10.5281/zenodo.8114649", "self_doi": "https://doi.org/10.5281/zenodo.8114649", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.8114649", "reserve_doi": "https://zenodo.org/api/records/8114649/draft/pids/doi", "parent": "https://zenodo.org/api/records/8114648", "parent_html": "https://zenodo.org/records/8114648", "parent_doi": "https://doi.org/10.5281/zenodo.8114648", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.8114648", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:8114649/manifest", "self_iiif_sequence": "https: