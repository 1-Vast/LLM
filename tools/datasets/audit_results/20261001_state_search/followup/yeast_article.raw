				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${z:}{{\mathbb{S}}}^{1}\to {{\mathbb{R}}}_{+}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M58"><mml:mi>z</mml:mi><mml:mo>:</mml:mo><mml:msup><mml:mrow><mml:mi mathvariant="double-struck">S</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msup><mml:mo>→</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="double-struck">R</mml:mi></mml:mrow><mml:mrow><mml:mo>+</mml:mo></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq24.gif"><?image-name 41467_2021_22689_Article_IEq24.gif?><?image-size 2253?><?image-md5 3fc75c77bd898c755e50c53fcf27d5ae?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 80?><?image-scaled-width 187?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/3fc75c77bd89/41467_2021_22689_Article_IEq24.gif?><?thumb-name 41467_2021_22689_Article_IEq24.gif?><?thumb-size 2253?><?thumb-md5 3fc75c77bd898c755e50c53fcf27d5ae?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 80?><?thumb-scaled-width 187?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/3fc75c77bd89/41467_2021_22689_Article_IEq24.gif?></inline-graphic></alternatives></inline-formula> models the linear response of the cell cycle phase <inline-formula id="IEq25"><alternatives><tex-math id="M59"><?equation-image-name M59.gif?><?equation-image-status READY?><?equation-image-md5 a8bf8e16d93ede2cbd292abe239c1a23?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/a8bf8e16d93e/M59.gif?>\documentclass[12pt]{minimal}
