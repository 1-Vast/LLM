				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\vartheta }_{{G}_{1}/S}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M200"><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>/</mml:mo><mml:mi>S</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq90.gif"><?image-name 41467_2021_22689_Article_IEq90.gif?><?image-size 288?><?image-md5 f706a79a6991631838947570c08bab0d?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 42?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/f706a79a6991/41467_2021_22689_Article_IEq90.gif?><?thumb-name 41467_2021_22689_Article_IEq90.gif?><?thumb-size 288?><?thumb-md5 f706a79a6991631838947570c08bab0d?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 42?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/f706a79a6991/41467_2021_22689_Article_IEq90.gif?></inline-graphic></alternatives></inline-formula> were obtained as<disp-formula id="Equ11"><label>11</label><alternatives><tex-math id="M201"><?equation-image-name M201.gif?><?equation-image-status READY?><?equation-image-md5 4fa9936c04754b7123494d0b7b0e1a4e?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/4fa9936c0475/M201.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{0}={T}_{{G}_{1}}+{T}_{S-{G}_{2}-M}=105\,{\rm{min}},$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M202"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi>S</mml:mi><mml:mo>−</mml:mo><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mo>−</mml:mo><mml:mi>M</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mn>105</mml:mn><mml:mspace width="0.25em"/><mml:mi mathvariant="normal">min</mml:mi><mml:mo>,</mml:mo></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ11.gif"><?image-name 41467_2021_22689_Article_Equ11.gif?><?image-size 1785?><?image-md5 382643c48a8d3311d934b4c78ffa8f94?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 27?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/382643c48a8d/41467_2021_22689_Article_Equ11.gif?><?thumb-name 41467_2021_22689_Article_Equ11.gif?><?thumb-size 1785?><?thumb-md5 382643c48a8d3311d934b4c78ffa8f94?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 27?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/382643c48a8d/41467_2021_22689_Article_Equ11.gif?></graphic></alternatives></disp-formula><disp-formula id="Equ12"><label>12</label><alternatives><tex-math id="M203"><?equation-image-name M203.gif?><?equation-image-status READY?><?equation-image-md5 eb69faf961c82803435604b87c22eada?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/eb69faf961c8/M203.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\vartheta }_{{G}_{1}/S}=2\pi \,\times \frac{{{T}_{{G}_{1}}}}{{{T}_{{G}_{1}}+{T}_{S-{G}_{2}-M}}}=\frac{4}{5}\pi .$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M204"><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>/</mml:mo><mml:mi>S</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mn>2</mml:mn><mml:mi>π</mml:mi><mml:mspace width="0.25em"/><mml:mo>×</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:msub></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi>S</mml:mi><mml:mo>−</mml:mo><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:msub><mml:mo>−</mml:mo><mml:mi>M</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mn>4</mml:mn></mml:mrow><mml:mrow><mml:mn>5</mml:mn></mml:mrow></mml:mfrac><mml:mi>π</mml:mi><mml:mo>.</mml:mo></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ12.gif"><?image-name 41467_2021_22689_Article_Equ12.gif?><?image-size 1880?><?image-md5 2b5f5b4d2a27845c30a94bda9817da02?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 43?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/2b5f5b4d2a27/41467_2021_22689_Article_Equ12.gif?><?thumb-name 41467_2021_22689_Article_Equ12.gif?><?thumb-size 1880?><?thumb-md5 2b5f5b4d2a27845c30a94bda9817da02?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 43?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/2b5f5b4d2a27/41467_2021_22689_Article_Equ12.gif?></graphic></alternatives></disp-formula></p><p id="Par46">The budding index (B.I.) was computed as the percentage of budded cells in the population:<disp-formula id="Equ13"><label>13</label><alternatives><tex-math id="M205"><?equation-image-name M205.gif?><?equation-image-status READY?><?equation-image-md5 59ce6ee3ac463c1a95abab72c863559b?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/59ce6ee3ac46/M205.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\rm{B}}.{\rm{I}}.\left(t\right)=\frac{{N}_{S-G2-M}\left(t\right)}{N\left(t\right)}\times 100,$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M206"><mml:mi mathvariant="normal">B</mml:mi><mml:mo>.</mml:mo><mml:mi mathvariant="normal">I</mml:mi><mml:mo>.</mml:mo><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:msub><mml:mrow><mml:mi>N</mml:mi></mml:mrow><mml:mrow><mml:mi>S</mml:mi><mml:mo>−</mml:mo><mml:mi>G</mml:mi><mml:mn>2</mml:mn><mml:mo>−</mml:mo><mml:mi>M</mml:mi></mml:mrow></mml:msub><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mrow><mml:mrow><mml:mi>N</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:mfrac><mml:mo>×</mml:mo><mml:mn>100</mml:mn><mml:mo>,</mml:mo></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ13.gif"><?image-name 41467_2021_22689_Article_Equ13.gif?><?image-size 2439?><?image-md5 1df616145e2c01cb7eeda3902ee54928?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 52?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/1df616145e2c/41467_2021_22689_Article_Equ13.gif?><?thumb-name 41467_2021_22689_Article_Equ13.gif?><?thumb-size 2439?><?thumb-md5 1df616145e2c01cb7eeda3902ee54928?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 52?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/1df616145e2c/41467_2021_22689_Article_Equ13.gif?></graphic></alternatives></disp-formula>where <italic toggle="yes">N</italic>(<italic toggle="yes">t</italic>) is the total number of cells at time <italic toggle="yes">t</italic> and <inline-formula id="IEq91"><alternatives><tex-math id="M207"><?equation-image-name M207.gif?><?equation-image-status READY?><?equation-image-md5 4def4a8786d8f1660bb7ad9bcf95e5fa?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/4def4a8786d8/M207.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${N}_{S-G2-M} (t)$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M208"><mml:msub><mml:mrow><mml:mi>N</mml:mi></mml:mrow><mml:mrow><mml:mi>S</mml:mi><mml:mo>−</mml:mo><mml:mi>G</mml:mi><mml:mn>2</mml:mn><mml:mo>−</mml:mo><mml:mi>M</mml:mi></mml:mrow></mml:msub><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mi>t</mml:mi></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq91.gif"><?image-name 41467_2021_22689_Article_IEq91.gif?><?image-size 3026?><?image-md5 1aec4f2599627cc65192e5b61f8a40b7?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 71?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/1aec4f259962/41467_2021_22689_Article_IEq91.gif?><?thumb-name 41467_2021_22689_Article_IEq91.gif?><?thumb-size 3026?><?thumb-md5 1aec4f2599627cc65192e5b61f8a40b7?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 71?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/1aec4f259962/41467_2021_22689_Article_IEq91.gif?></inline-graphic></alternatives></inline-formula> is the number of budded cells (i.e. cells in the S-G<sub>2</sub>-M phases) at time <inline-formula id="IEq92"><alternatives><tex-math id="M209"><?equation-image-name M209.gif?><?equation-image-status READY?><?equation-image-md5 391609a27f82f32ab01d56e0381b9eaa?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/391609a27f82/M209.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
