				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\hat{\vartheta }$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M170"><mml:mover accent="true"><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:mo>^</mml:mo></mml:mrow></mml:mover></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq76.gif"><?image-name 41467_2021_22689_Article_IEq76.gif?><?image-size 239?><?image-md5 bfa9e91083b8a802c67f0ec0576acc4c?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 37?><?image-scaled-width 14?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/bfa9e91083b8/41467_2021_22689_Article_IEq76.gif?><?thumb-name 41467_2021_22689_Article_IEq76.gif?><?thumb-size 239?><?thumb-md5 bfa9e91083b8a802c67f0ec0576acc4c?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 37?><?thumb-scaled-width 14?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/bfa9e91083b8/41467_2021_22689_Article_IEq76.gif?></inline-graphic></alternatives></inline-formula> was computed as<disp-formula id="Equ10"><label>10</label><alternatives><tex-math id="M171"><?equation-image-name M171.gif?><?equation-image-status READY?><?equation-image-md5 a264989ffd8bc2e3085cbdcd2502be51?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/a264989ffd8b/M171.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\hat{\vartheta }\left(t\right)=\left\{\begin{array}{cc}\frac{2\pi }{{T}_{0}}\times \left(t-{T}_{t}\right) &amp; {\rm{if}}\,{\rm{on}}\to {\rm{off}}\\ \frac{2\pi }{{T}_{0}}\times \left(t-{T}_{t}\right)+{\vartheta }_{{G}_{1}/S} &amp; {\rm{if}}\,{\rm{off}}\to {\rm{on}}\end{array}\right.,$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M172"><mml:mover accent="true"><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:mo>^</mml:mo></mml:mrow></mml:mover><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced><mml:mo>=</mml:mo><mml:mfenced open="{"><mml:mrow><mml:mtable><mml:mtr><mml:mtd columnalign="center"><mml:mfrac><mml:mrow><mml:mn>2</mml:mn><mml:mi>π</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mo>×</mml:mo><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi><mml:mo>−</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced></mml:mtd><mml:mtd columnalign="center"><mml:mi mathvariant="normal">if</mml:mi><mml:mspace width="0.25em"/><mml:mi mathvariant="normal">on</mml:mi><mml:mo>→</mml:mo><mml:mi mathvariant="normal">off</mml:mi></mml:mtd></mml:mtr><mml:mtr><mml:mtd columnalign="center"><mml:mfrac><mml:mrow><mml:mn>2</mml:mn><mml:mi>π</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mo>×</mml:mo><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi><mml:mo>−</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>/</mml:mo><mml:mi>S</mml:mi></mml:mrow></mml:msub></mml:mtd><mml:mtd columnalign="center"><mml:mi mathvariant="normal">if</mml:mi><mml:mspace width="0.25em"/><mml:mi mathvariant="normal">off</mml:mi><mml:mo>→</mml:mo><mml:mi mathvariant="normal">on</mml:mi></mml:mtd></mml:mtr></mml:mtable></mml:mrow></mml:mfenced><mml:mo>,</mml:mo></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ10.gif"><?image-name 41467_2021_22689_Article_Equ10.gif?><?image-size 2124?><?image-md5 b076857be9c9032b1804f5a1591a9247?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 42?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/b076857be9c9/41467_2021_22689_Article_Equ10.gif?><?thumb-name 41467_2021_22689_Article_Equ10.gif?><?thumb-size 2124?><?thumb-md5 b076857be9c9032b1804f5a1591a9247?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 42?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/b076857be9c9/41467_2021_22689_Article_Equ10.gif?></graphic></alternatives></disp-formula>where <inline-formula id="IEq77"><alternatives><tex-math id="M173"><?equation-image-name M173.gif?><?equation-image-status READY?><?equation-image-md5 c1ac16dc902e9e919192abf8a0dad3ef?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/c1ac16dc902e/M173.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{0}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M174"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq77.gif"><?image-name 41467_2021_22689_Article_IEq77.gif?><?image-size 194?><?image-md5 2e5d716b6cf38638afbcec9601113364?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 21?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/2e5d716b6cf3/41467_2021_22689_Article_IEq77.gif?><?thumb-name 41467_2021_22689_Article_IEq77.gif?><?thumb-size 194?><?thumb-md5 2e5d716b6cf38638afbcec9601113364?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 21?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/2e5d716b6cf3/41467_2021_22689_Article_IEq77.gif?></inline-graphic></alternatives></inline-formula> is the nominal cell cycle period in the cycling strain, <inline-formula id="IEq78"><alternatives><tex-math id="M175"><?equation-image-name M175.gif?><?equation-image-status READY?><?equation-image-md5 458c7224ef3fd547cab576f1964fd915?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/458c7224ef3f/M175.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{t}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M176"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq78.gif"><?image-name 41467_2021_22689_Article_IEq78.gif?><?image-size 174?><?image-md5 9508c64c7ca800e6654e6ee6712b5960?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 18?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/9508c64c7ca8/41467_2021_22689_Article_IEq78.gif?><?thumb-name 41467_2021_22689_Article_IEq78.gif?><?thumb-size 174?><?thumb-md5 9508c64c7ca800e6654e6ee6712b5960?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 18?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/9508c64c7ca8/41467_2021_22689_Article_IEq78.gif?></inline-graphic></alternatives></inline-formula> is the time interval from the last binary transition to the current time and <inline-formula id="IEq79"><alternatives><tex-math id="M177"><?equation-image-name M177.gif?><?equation-image-status READY?><?equation-image-md5 b48c5955849d6362410acefbadee670c?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/b48c5955849d/M177.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\vartheta }_{{G}_{1}/S}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M178"><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>/</mml:mo><mml:mi>S</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq79.gif"><?image-name 41467_2021_22689_Article_IEq79.gif?><?image-size 288?><?image-md5 f706a79a6991631838947570c08bab0d?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 42?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/f706a79a6991/41467_2021_22689_Article_IEq79.gif?><?thumb-name 41467_2021_22689_Article_IEq79.gif?><?thumb-size 288?><?thumb-md5 f706a79a6991631838947570c08bab0d?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 42?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/f706a79a6991/41467_2021_22689_Article_IEq79.gif?></inline-graphic></alternatives></inline-formula> is the phase value at which occurs the G<sub>1</sub>/S transition. If a cell did not show a binary transition during the observation period, then the cell cycle phase could not be estimated. To further improve the quality of results, we set a minimum duration of 14 min between two successive binary transitions. Part of this procedure was used to estimate the nominal cell cycle period <inline-formula id="IEq80"><alternatives><tex-math id="M179"><?equation-image-name M179.gif?><?equation-image-status READY?><?equation-image-md5 c1ac16dc902e9e919192abf8a0dad3ef?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/c1ac16dc902e/M179.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{0}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M180"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq80.gif"><?image-name 41467_2021_22689_Article_IEq80.gif?><?image-size 194?><?image-md5 2e5d716b6cf38638afbcec9601113364?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 21?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/2e5d716b6cf3/41467_2021_22689_Article_IEq80.gif?><?thumb-name 41467_2021_22689_Article_IEq80.gif?><?thumb-size 194?><?thumb-md5 2e5d716b6cf38638afbcec9601113364?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 21?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/2e5d716b6cf3/41467_2021_22689_Article_IEq80.gif?></inline-graphic></alternatives></inline-formula> and the phase value <inline-formula id="IEq81"><alternatives><tex-math id="M181"><?equation-image-name M181.gif?><?equation-image-status READY?><?equation-image-md5 b48c5955849d6362410acefbadee670c?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/b48c5955849d/M181.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\vartheta }_{{G}_{1}/S}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M182"><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>/</mml:mo><mml:mi>S</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq81.gif"><?image-name 41467_2021_22689_Article_IEq81.gif?><?image-size 288?><?image-md5 f706a79a6991631838947570c08bab0d?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 42?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/f706a79a6991/41467_2021_22689_Article_IEq81.gif?><?thumb-name 41467_2021_22689_Article_IEq81.gif?><?thumb-size 288?><?thumb-md5 f706a79a6991631838947570c08bab0d?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 42?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/f706a79a6991/41467_2021_22689_Article_IEq81.gif?></inline-graphic></alternatives></inline-formula> from the raw fluorescence traces of an uncontrolled +MET experiment (Supplementary Data <xref rid="MOESM4" ref-type="media">1</xref>). Specifically, the single-cell raw fluorescence signals were binarized using a threshold value <inline-formula id="IEq82"><alternatives><tex-math id="M183"><?equation-image-name M183.gif?><?equation-image-status READY?><?equation-image-md5 0c895e9af837bba7a4c675145828013c?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/0c895e9af837/M183.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$l$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M184"><mml:mi>l</mml:mi></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq82.gif"><?image-name 41467_2021_22689_Article_IEq82.gif?><?image-size 129?><?image-md5 f7ebc8c41dab5e0114526de557568180?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 9?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/f7ebc8c41dab/41467_2021_22689_Article_IEq82.gif?><?thumb-name 41467_2021_22689_Article_IEq82.gif?><?thumb-size 129?><?thumb-md5 f7ebc8c41dab5e0114526de557568180?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 9?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/f7ebc8c41dab/41467_2021_22689_Article_IEq82.gif?></inline-graphic></alternatives></inline-formula>. Then, the nominal duration of the unbudded phase <inline-formula id="IEq83"><alternatives><tex-math id="M185"><?equation-image-name M185.gif?><?equation-image-status READY?><?equation-image-md5 3ae315676585e6cabc082ea7ac09b7ad?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/3ae315676585/M185.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{{G}_{1}}=42$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M186"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mn>42</mml:mn></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq83.gif"><?image-name 41467_2021_22689_Article_IEq83.gif?><?image-size 2280?><?image-md5 33cc0b71057c95fd63d58e38f4b79e08?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 80?><?image-scaled-width 184?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/33cc0b71057c/41467_2021_22689_Article_IEq83.gif?><?thumb-name 41467_2021_22689_Article_IEq83.gif?><?thumb-size 2280?><?thumb-md5 33cc0b71057c95fd63d58e38f4b79e08?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 80?><?thumb-scaled-width 184?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/33cc0b71057c/41467_2021_22689_Article_IEq83.gif?></inline-graphic></alternatives></inline-formula> min was computed as the median of the intervals measured in all binary traces between an on to off (<inline-formula id="IEq84"><alternatives><tex-math id="M187"><?equation-image-name M187.gif?><?equation-image-status READY?><?equation-image-md5 1d8e9857016c878b1f0f38cb61a661e4?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/1d8e9857016c/M187.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\rm{on}}\to {\rm{off}}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M188"><mml:mi mathvariant="normal">on</mml:mi><mml:mo>→</mml:mo><mml:mi mathvariant="normal">off</mml:mi></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq84.gif"><?image-name 41467_2021_22689_Article_IEq84.gif?><?image-size 1729?><?image-md5 9a76a3b1e58c523e1df5bf05e5b75146?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 80?><?image-scaled-width 178?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/9a76a3b1e58c/41467_2021_22689_Article_IEq84.gif?><?thumb-name 41467_2021_22689_Article_IEq84.gif?><?thumb-size 1729?><?thumb-md5 9a76a3b1e58c523e1df5bf05e5b75146?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 80?><?thumb-scaled-width 178?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/9a76a3b1e58c/41467_2021_22689_Article_IEq84.gif?></inline-graphic></alternatives></inline-formula>) and an off to on (<inline-formula id="IEq85"><alternatives><tex-math id="M189"><?equation-image-name M189.gif?><?equation-image-status READY?><?equation-image-md5 8010413cf2e8366d01ae089c16a6bf45?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/8010413cf2e8/M189.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\rm{off}}\to {\rm{on}}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M190"><mml:mi mathvariant="normal">off</mml:mi><mml:mo>→</mml:mo><mml:mi mathvariant="normal">on</mml:mi></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq85.gif"><?image-name 41467_2021_22689_Article_IEq85.gif?><?image-size 1731?><?image-md5 5085e293e72f13a9aeb86f18c46c8b22?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 80?><?image-scaled-width 178?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/5085e293e72f/41467_2021_22689_Article_IEq85.gif?><?thumb-name 41467_2021_22689_Article_IEq85.gif?><?thumb-size 1731?><?thumb-md5 5085e293e72f13a9aeb86f18c46c8b22?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 80?><?thumb-scaled-width 178?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/5085e293e72f/41467_2021_22689_Article_IEq85.gif?></inline-graphic></alternatives></inline-formula>) transition. Similarly, the nominal duration of the budded phase <inline-formula id="IEq86"><alternatives><tex-math id="M191"><?equation-image-name M191.gif?><?equation-image-status READY?><?equation-image-md5 c3d1b963f5cd1b398b458337aa2de7b2?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/c3d1b963f5cd/M191.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
