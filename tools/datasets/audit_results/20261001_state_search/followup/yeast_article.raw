				\begin{document}$$t$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M154"><mml:mi>t</mml:mi></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq68.gif"><?image-name 41467_2021_22689_Article_IEq68.gif?><?image-size 127?><?image-md5 a9ec1de4f07d4138723851503cd41823?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 9?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/a9ec1de4f07d/41467_2021_22689_Article_IEq68.gif?><?thumb-name 41467_2021_22689_Article_IEq68.gif?><?thumb-size 127?><?thumb-md5 a9ec1de4f07d4138723851503cd41823?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 9?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/a9ec1de4f07d/41467_2021_22689_Article_IEq68.gif?></inline-graphic></alternatives></inline-formula>. <inline-formula id="IEq69"><alternatives><tex-math id="M155"><?equation-image-name M155.gif?><?equation-image-status READY?><?equation-image-md5 10726f426ba6a76ac0bdd28286c96526?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/10726f426ba6/M155.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
