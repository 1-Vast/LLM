				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\rm{CLN}}{2}_{{\rm{ref}}}\left(t\right) = \left\{\begin{array}{cc} 0 &amp; {\rm{if}}\,{kT}\le t &lt; {kT}+{T}_{{{\rm{flat}}}}\\ \frac{1}{2}-\frac{1}{2}{{\cos }}\left(\frac{2\pi }{{T}_{0}}\times t\right) &amp; {\rm{if}}\,{kT}+{T}_{{{\rm{flat}}}}\le t &lt; \left(k+1\right)T\end{array},\right.\forall k\in {{\mathbb{N}}}_{0},$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M106"><mml:mi mathvariant="normal">CLN</mml:mi><mml:msub><mml:mrow><mml:mn>2</mml:mn></mml:mrow><mml:mrow><mml:mi mathvariant="normal">ref</mml:mi></mml:mrow></mml:msub><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced><mml:mo>=</mml:mo><mml:mfenced open="{"><mml:mrow><mml:mtable><mml:mtr><mml:mtd columnalign="center"><mml:mn>0</mml:mn></mml:mtd><mml:mtd columnalign="center"><mml:mi mathvariant="normal">if</mml:mi><mml:mspace width="0.25em"/><mml:mi>k</mml:mi><mml:mi>T</mml:mi><mml:mo>≤</mml:mo><mml:mi>t</mml:mi><mml:mo>&lt;</mml:mo><mml:mi>k</mml:mi><mml:mi>T</mml:mi><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">flat</mml:mi></mml:mrow></mml:msub></mml:mtd></mml:mtr><mml:mtr><mml:mtd columnalign="center"><mml:mfrac><mml:mrow><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:mfrac><mml:mo>−</mml:mo><mml:mfrac><mml:mrow><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mn>2</mml:mn></mml:mrow></mml:mfrac><mml:mi>cos</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mfrac><mml:mrow><mml:mn>2</mml:mn><mml:mi>π</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub></mml:mrow></mml:mfrac><mml:mo>×</mml:mo><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mtd><mml:mtd columnalign="center"><mml:mi mathvariant="normal">if</mml:mi><mml:mspace width="0.25em"/><mml:mi>k</mml:mi><mml:mi>T</mml:mi><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">flat</mml:mi></mml:mrow></mml:msub><mml:mo>≤</mml:mo><mml:mi>t</mml:mi><mml:mo>&lt;</mml:mo><mml:mfenced close=")" open="("><mml:mrow><mml:mi>k</mml:mi><mml:mo>+</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:mfenced><mml:mi>T</mml:mi></mml:mtd></mml:mtr></mml:mtable><mml:mo>,</mml:mo></mml:mrow></mml:mfenced><mml:mo>∀</mml:mo><mml:mi>k</mml:mi><mml:mo>∈</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="double-struck">N</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub><mml:mo>,</mml:mo></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ7.gif"><?image-name 41467_2021_22689_Article_Equ7.gif?><?image-size 1157?><?image-md5 6c5ef88615e493e3a98abd37ec44a142?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 26?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/6c5ef88615e4/41467_2021_22689_Article_Equ7.gif?><?thumb-name 41467_2021_22689_Article_Equ7.gif?><?thumb-size 1157?><?thumb-md5 6c5ef88615e493e3a98abd37ec44a142?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 26?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/6c5ef88615e4/41467_2021_22689_Article_Equ7.gif?></graphic></alternatives></disp-formula>where <inline-formula id="IEq47"><alternatives><tex-math id="M107"><?equation-image-name M107.gif?><?equation-image-status READY?><?equation-image-md5 6bb8978c576e6a08b3c6f656cbc05f56?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/6bb8978c576e/M107.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$T={T}_{{{\rm{flat}}}}+{T}_{0}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M108"><mml:mi>T</mml:mi><mml:mo>=</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">flat</mml:mi></mml:mrow></mml:msub><mml:mo>+</mml:mo><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq47.gif"><?image-name 41467_2021_22689_Article_IEq47.gif?><?image-size 2310?><?image-md5 579bd22553f70c9a9ac320dfee4f6fff?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 59?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/579bd22553f7/41467_2021_22689_Article_IEq47.gif?><?thumb-name 41467_2021_22689_Article_IEq47.gif?><?thumb-size 2310?><?thumb-md5 579bd22553f70c9a9ac320dfee4f6fff?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 59?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/579bd22553f7/41467_2021_22689_Article_IEq47.gif?></inline-graphic></alternatives></inline-formula> is the period of the reference signal, <inline-formula id="IEq48"><alternatives><tex-math id="M109"><?equation-image-name M109.gif?><?equation-image-status READY?><?equation-image-md5 2014ddeed5378283d1388b49d376611a?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/2014ddeed537/M109.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{{{\rm{flat}}}}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M110"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">flat</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq48.gif"><?image-name 41467_2021_22689_Article_IEq48.gif?><?image-size 287?><?image-md5 95b39a108a197eca77fc9b509bf2aa9b?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 30?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/95b39a108a19/41467_2021_22689_Article_IEq48.gif?><?thumb-name 41467_2021_22689_Article_IEq48.gif?><?thumb-size 287?><?thumb-md5 95b39a108a197eca77fc9b509bf2aa9b?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 30?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/95b39a108a19/41467_2021_22689_Article_IEq48.gif?></inline-graphic></alternatives></inline-formula> is a fake time interval in which the cell is assumed to be halted in the G<sub>1</sub> phase and <inline-formula id="IEq49"><alternatives><tex-math id="M111"><?equation-image-name M111.gif?><?equation-image-status READY?><?equation-image-md5 c1ac16dc902e9e919192abf8a0dad3ef?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/c1ac16dc902e/M111.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{0}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M112"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mn>0</mml:mn></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq49.gif"><?image-name 41467_2021_22689_Article_IEq49.gif?><?image-size 194?><?image-md5 2e5d716b6cf38638afbcec9601113364?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 21?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/2e5d716b6cf3/41467_2021_22689_Article_IEq49.gif?><?thumb-name 41467_2021_22689_Article_IEq49.gif?><?thumb-size 194?><?thumb-md5 2e5d716b6cf38638afbcec9601113364?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 21?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/2e5d716b6cf3/41467_2021_22689_Article_IEq49.gif?></inline-graphic></alternatives></inline-formula> is the nominal cell cycle period in the non-cycling strain. The first part of the periodic reference signal describes the situation in which the cell has a flat fluorescence signal, that is when it is halted in the G<sub>1</sub> phase, and thus the duration <inline-formula id="IEq50"><alternatives><tex-math id="M113"><?equation-image-name M113.gif?><?equation-image-status READY?><?equation-image-md5 2014ddeed5378283d1388b49d376611a?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/2014ddeed537/M113.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{{\rm{flat}}}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M114"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">flat</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq50.gif"><?image-name 41467_2021_22689_Article_IEq50.gif?><?image-size 287?><?image-md5 95b39a108a197eca77fc9b509bf2aa9b?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 30?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/95b39a108a19/41467_2021_22689_Article_IEq50.gif?><?thumb-name 41467_2021_22689_Article_IEq50.gif?><?thumb-size 287?><?thumb-md5 95b39a108a197eca77fc9b509bf2aa9b?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 30?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/95b39a108a19/41467_2021_22689_Article_IEq50.gif?></inline-graphic></alternatives></inline-formula> must be set equal to the length of the compared fluorescence signal. Instead, the second part models the oscillatory <italic toggle="yes">CLN2-YFP</italic> expression in a cell that is cycling, i.e. when it is fed with methionine-free medium. At each sampling time <inline-formula id="IEq51"><alternatives><tex-math id="M115"><?equation-image-name M115.gif?><?equation-image-status READY?><?equation-image-md5 391609a27f82f32ab01d56e0381b9eaa?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/391609a27f82/M115.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$t$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M116"><mml:mi>t</mml:mi></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq51.gif"><?image-name 41467_2021_22689_Article_IEq51.gif?><?image-size 127?><?image-md5 a9ec1de4f07d4138723851503cd41823?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 9?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/a9ec1de4f07d/41467_2021_22689_Article_IEq51.gif?><?thumb-name 41467_2021_22689_Article_IEq51.gif?><?thumb-size 127?><?thumb-md5 a9ec1de4f07d4138723851503cd41823?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 9?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/a9ec1de4f07d/41467_2021_22689_Article_IEq51.gif?></inline-graphic></alternatives></inline-formula>, the measured fluorescence signal was cross-correlated with the periodic reference signal evaluating the Pearson’s correlation coefficient <inline-formula id="IEq52"><alternatives><tex-math id="M117"><?equation-image-name M117.gif?><?equation-image-status READY?><?equation-image-md5 0a33f142b04d4b3cd850a4b1bf7f5fde?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/0a33f142b04d/M117.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
