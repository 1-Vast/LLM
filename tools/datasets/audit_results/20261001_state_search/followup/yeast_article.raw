				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$R\in [0, 1]$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M214"><mml:mi>R</mml:mi><mml:mo>∈</mml:mo><mml:mrow><mml:mo>[</mml:mo><mml:mrow><mml:mn>0</mml:mn><mml:mo>,</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mo>]</mml:mo></mml:mrow></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq94.gif"><?image-name 41467_2021_22689_Article_IEq94.gif?><?image-size 2651?><?image-md5 cf747575d1968b60c9e1f5280c1dd7c8?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 80?><?image-scaled-width 190?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/cf747575d196/41467_2021_22689_Article_IEq94.gif?><?thumb-name 41467_2021_22689_Article_IEq94.gif?><?thumb-size 2651?><?thumb-md5 cf747575d1968b60c9e1f5280c1dd7c8?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 80?><?thumb-scaled-width 190?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/cf747575d196/41467_2021_22689_Article_IEq94.gif?></inline-graphic></alternatives></inline-formula> and the mean phase <inline-formula id="IEq95"><alternatives><tex-math id="M215"><?equation-image-name M215.gif?><?equation-image-status READY?><?equation-image-md5 90984c39519b4277198a53661158d78a?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/90984c39519b/M215.gif?>\documentclass[12pt]{minimal}
