				\begin{document}$$m$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M224"><mml:mi>m</mml:mi></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq98.gif"><?image-name 41467_2021_22689_Article_IEq98.gif?><?image-size 169?><?image-md5 a82c5f63709c502713fda5a8e4c61327?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 16?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/a82c5f63709c/41467_2021_22689_Article_IEq98.gif?><?thumb-name 41467_2021_22689_Article_IEq98.gif?><?thumb-size 169?><?thumb-md5 a82c5f63709c502713fda5a8e4c61327?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 16?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/a82c5f63709c/41467_2021_22689_Article_IEq98.gif?></inline-graphic></alternatives></inline-formula>th cell, both evaluated at time <inline-formula id="IEq99"><alternatives><tex-math id="M225"><?equation-image-name M225.gif?><?equation-image-status READY?><?equation-image-md5 391609a27f82f32ab01d56e0381b9eaa?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/391609a27f82/M225.gif?>\documentclass[12pt]{minimal}
