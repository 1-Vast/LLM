				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${a}_{m}\left({t}_{k}\right)=\left\{\begin{array}{cc}1 &amp; {\rm{if}}\,0\le {\vartheta }_{m}\left({t}_{k}\right) &lt; {\vartheta }_{{G}_{1}/S}\\ 0 &amp; {\rm{if}}\,{\vartheta }_{{G}_{1}/S}\le {\vartheta }_{m}\left({t}_{k}\right) &lt; 2\pi \end{array}\right.,$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M286"><mml:msub><mml:mrow><mml:mi>a</mml:mi></mml:mrow><mml:mrow><mml:mi>m</mml:mi></mml:mrow></mml:msub><mml:mfenced close=")" open="("><mml:mrow><mml:msub><mml:mrow><mml:mi>t</mml:mi></mml:mrow><mml:mrow><mml:mi>k</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mo>=</mml:mo><mml:mfenced open="{"><mml:mrow><mml:mtable><mml:mtr><mml:mtd columnalign="center"><mml:mn>1</mml:mn></mml:mtd><mml:mtd columnalign="center"><mml:mi mathvariant="normal">if</mml:mi><mml:mspace width="0.25em"/><mml:mn>0</mml:mn><mml:mo>≤</mml:mo><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:mi>m</mml:mi></mml:mrow></mml:msub><mml:mfenced close=")" open="("><mml:mrow><mml:msub><mml:mrow><mml:mi>t</mml:mi></mml:mrow><mml:mrow><mml:mi>k</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mo>&lt;</mml:mo><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>/</mml:mo><mml:mi>S</mml:mi></mml:mrow></mml:msub></mml:mtd></mml:mtr><mml:mtr><mml:mtd columnalign="center"><mml:mn>0</mml:mn></mml:mtd><mml:mtd columnalign="center"><mml:mi mathvariant="normal">if</mml:mi><mml:mspace width="0.25em"/><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>/</mml:mo><mml:mi>S</mml:mi></mml:mrow></mml:msub><mml:mo>≤</mml:mo><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:mi>m</mml:mi></mml:mrow></mml:msub><mml:mfenced close=")" open="("><mml:mrow><mml:msub><mml:mrow><mml:mi>t</mml:mi></mml:mrow><mml:mrow><mml:mi>k</mml:mi></mml:mrow></mml:msub></mml:mrow></mml:mfenced><mml:mo>&lt;</mml:mo><mml:mn>2</mml:mn><mml:mi>π</mml:mi></mml:mtd></mml:mtr></mml:mtable></mml:mrow></mml:mfenced><mml:mo>,</mml:mo></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ17.gif"><?image-name 41467_2021_22689_Article_Equ17.gif?><?image-size 2543?><?image-md5 2e7cc4b8aa1e924c466b76b2dc91024e?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 44?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/2e7cc4b8aa1e/41467_2021_22689_Article_Equ17.gif?><?thumb-name 41467_2021_22689_Article_Equ17.gif?><?thumb-size 2543?><?thumb-md5 2e7cc4b8aa1e924c466b76b2dc91024e?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 44?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/2e7cc4b8aa1e/41467_2021_22689_Article_Equ17.gif?></graphic></alternatives></disp-formula>where <inline-formula id="IEq127"><alternatives><tex-math id="M287"><?equation-image-name M287.gif?><?equation-image-status READY?><?equation-image-md5 b48c5955849d6362410acefbadee670c?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/b48c5955849d/M287.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\vartheta }_{{G}_{1}/S}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M288"><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>/</mml:mo><mml:mi>S</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq127.gif"><?image-name 41467_2021_22689_Article_IEq127.gif?><?image-size 288?><?image-md5 f706a79a6991631838947570c08bab0d?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 42?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/f706a79a6991/41467_2021_22689_Article_IEq127.gif?><?thumb-name 41467_2021_22689_Article_IEq127.gif?><?thumb-size 288?><?thumb-md5 f706a79a6991631838947570c08bab0d?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 42?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/f706a79a6991/41467_2021_22689_Article_IEq127.gif?></inline-graphic></alternatives></inline-formula> is the phase at the G<sub>1</sub> to S transition according to the phase estimation algorithm (see Phase estimation and budding index). Finally, the algorithm integrates the ODE model of the reference oscillator to obtain the value of the reference phase <inline-formula id="IEq128"><alternatives><tex-math id="M289"><?equation-image-name M289.gif?><?equation-image-status READY?><?equation-image-md5 4b73768a714e01a4321ac2ec63ae05d5?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/4b73768a714e/M289.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\vartheta }_{r}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M290"><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:mi>r</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq128.gif"><?image-name 41467_2021_22689_Article_IEq128.gif?><?image-size 187?><?image-md5 c3faa317168c9b4e09cd0a6f37e9997e?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 20?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/c3faa317168c/41467_2021_22689_Article_IEq128.gif?><?thumb-name 41467_2021_22689_Article_IEq128.gif?><?thumb-size 187?><?thumb-md5 c3faa317168c9b4e09cd0a6f37e9997e?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 20?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/c3faa317168c/41467_2021_22689_Article_IEq128.gif?></inline-graphic></alternatives></inline-formula> at the next sampling time <inline-formula id="IEq129"><alternatives><tex-math id="M291"><?equation-image-name M291.gif?><?equation-image-status READY?><?equation-image-md5 f25ca175225e4e46983bd3138eff6780?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/f25ca175225e/M291.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${t}_{k+1}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M292"><mml:msub><mml:mrow><mml:mi>t</mml:mi></mml:mrow><mml:mrow><mml:mi>k</mml:mi><mml:mo>+</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq129.gif"><?image-name 41467_2021_22689_Article_IEq129.gif?><?image-size 206?><?image-md5 96aaeffe29f987bc34eadce9eb975514?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 28?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/96aaeffe29f9/41467_2021_22689_Article_IEq129.gif?><?thumb-name 41467_2021_22689_Article_IEq129.gif?><?thumb-size 206?><?thumb-md5 96aaeffe29f987bc34eadce9eb975514?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 28?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/96aaeffe29f9/41467_2021_22689_Article_IEq129.gif?></inline-graphic></alternatives></inline-formula>. To integrate the reference oscillator ODE, we used the MATLAB numerical solver <italic toggle="yes">ode45</italic>. Controller’s parameters used in our implementation were: <inline-formula id="IEq130"><alternatives><tex-math id="M293"><?equation-image-name M293.gif?><?equation-image-status READY?><?equation-image-md5 e36dfe6a282bb38f417cec8065ec7210?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/e36dfe6a282b/M293.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\omega }_{r}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M294"><mml:msub><mml:mrow><mml:mi>ω</mml:mi></mml:mrow><mml:mrow><mml:mi>r</mml:mi></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq130.gif"><?image-name 41467_2021_22689_Article_IEq130.gif?><?image-size 234?><?image-md5 af818c9a4af1dca3d95c0e39b8ec099c?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 21?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/af818c9a4af1/41467_2021_22689_Article_IEq130.gif?><?thumb-name 41467_2021_22689_Article_IEq130.gif?><?thumb-size 234?><?thumb-md5 af818c9a4af1dca3d95c0e39b8ec099c?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 21?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/af818c9a4af1/41467_2021_22689_Article_IEq130.gif?></inline-graphic></alternatives></inline-formula> equals to the nominal natural velocity of the cell cycle in the cycling strain (see Modelling section), and <inline-formula id="IEq131"><alternatives><tex-math id="M295"><?equation-image-name M295.gif?><?equation-image-status READY?><?equation-image-md5 0e655c691285ccf0695c93aba920ba6c?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/0e655c691285/M295.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\gamma =1$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M296"><mml:mi>γ</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq131.gif"><?image-name 41467_2021_22689_Article_IEq131.gif?><?image-size 205?><?image-md5 87522daefd527b79b51305e8699b77f3?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 42?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/87522daefd52/41467_2021_22689_Article_IEq131.gif?><?thumb-name 41467_2021_22689_Article_IEq131.gif?><?thumb-size 205?><?thumb-md5 87522daefd527b79b51305e8699b77f3?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 42?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/87522daefd52/41467_2021_22689_Article_IEq131.gif?></inline-graphic></alternatives></inline-formula> (coupling strength). The initial condition of the reference oscillator phase was <inline-formula id="IEq132"><alternatives><tex-math id="M297"><?equation-image-name M297.gif?><?equation-image-status READY?><?equation-image-md5 f4167dc72367815ea85f0e46ceda5de8?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/f4167dc72367/M297.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
				\usepackage{wasysym} 
				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${\vartheta }_{r,0}=0$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M298"><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:mi>r</mml:mi><mml:mo>,</mml:mo><mml:mn>0</mml:mn></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mn>0</mml:mn></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq132.gif"><?image-name 41467_2021_22689_Article_IEq132.gif?><?image-size 332?><?image-md5 11b9c1490d0b21d1ee07bc0090288b7e?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 57?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/11b9c1490d0b/41467_2021_22689_Article_IEq132.gif?><?thumb-name 41467_2021_22689_Article_IEq132.gif?><?thumb-size 332?><?thumb-md5 11b9c1490d0b21d1ee07bc0090288b7e?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 57?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/11b9c1490d0b/41467_2021_22689_Article_IEq132.gif?></inline-graphic></alternatives></inline-formula>. For the complete details of the reference oscillator strategy, including the derivation of the state feedback control law, refer to the <xref rid="MOESM1" ref-type="media">Supplementary Notes</xref>.</p></sec></sec><sec id="Sec18"><title>Reporting summary</title><p id="Par53">Further information on research design is available in the <xref rid="MOESM11" ref-type="media">Nature Research Reporting Summary</xref> linked to this article.</p></sec></sec><sec sec-type="supplementary-material"><title>Supplementary information</title><sec id="Sec19"><supplementary-material content-type="local-data" id="MOESM1" position="float" orientation="portrait"><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_MOESM1_ESM.pdf" position="float" orientation="portrait"><?suppdata-name 41467_2021_22689_MOESM1_ESM.pdf?><?suppdata-size 4269088?><?suppdata-md5 fe4b3ddf77d7868b9926b0d44537a554?><?suppdat