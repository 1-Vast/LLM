				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\begin{array}{c}{f}_{c}\left(\vartheta \right)=\omega .\end{array}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M56"><mml:mtable><mml:mtr><mml:mtd columnalign="center"><mml:msub><mml:mrow><mml:mi>f</mml:mi></mml:mrow><mml:mrow><mml:mi>c</mml:mi></mml:mrow></mml:msub><mml:mfenced close=")" open="("><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow></mml:mfenced><mml:mo>=</mml:mo><mml:mi>ω</mml:mi><mml:mo>.</mml:mo></mml:mtd></mml:mtr></mml:mtable></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ5.gif"><?image-name 41467_2021_22689_Article_Equ5.gif?><?image-size 2461?><?image-md5 730d9dbbf5c120a945ebf5bf3a9d18af?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 80?><?image-scaled-width 190?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/730d9dbbf5c1/41467_2021_22689_Article_Equ5.gif?><?thumb-name 41467_2021_22689_Article_Equ5.gif?><?thumb-size 2461?><?thumb-md5 730d9dbbf5c120a945ebf5bf3a9d18af?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 80?><?thumb-scaled-width 190?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/730d9dbbf5c1/41467_2021_22689_Article_Equ5.gif?></graphic></alternatives></disp-formula></p><p id="Par41">Finally, the phase response curve <inline-formula id="IEq24"><alternatives><tex-math id="M57"><?equation-image-name M57.gif?><?equation-image-status READY?><?equation-image-md5 41241d798cd72531c2bd3b55987e0206?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/41241d798cd7/M57.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
