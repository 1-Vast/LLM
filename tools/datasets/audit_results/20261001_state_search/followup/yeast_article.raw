				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\begin{array}{c}\frac{{\rm{d}}}{{{\rm{d}}t}}V=g\left(\vartheta \right),\end{array}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M16"><mml:mtable><mml:mtr><mml:mtd columnalign="center"><mml:mfrac><mml:mrow><mml:mi mathvariant="normal">d</mml:mi></mml:mrow><mml:mrow><mml:mi mathvariant="normal">d</mml:mi><mml:mi>t</mml:mi></mml:mrow></mml:mfrac><mml:mi>V</mml:mi><mml:mo>=</mml:mo><mml:mi>g</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow></mml:mfenced><mml:mo>,</mml:mo></mml:mtd></mml:mtr></mml:mtable></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ2.gif"><?image-name 41467_2021_22689_Article_Equ2.gif?><?image-size 2783?><?image-md5 9c5f7f4c2bc9aa3f4bbe651f3e9e7525?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 75?><?image-scaled-width 200?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/9c5f7f4c2bc9/41467_2021_22689_Article_Equ2.gif?><?thumb-name 41467_2021_22689_Article_Equ2.gif?><?thumb-size 2783?><?thumb-md5 9c5f7f4c2bc9aa3f4bbe651f3e9e7525?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 75?><?thumb-scaled-width 200?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/9c5f7f4c2bc9/41467_2021_22689_Article_Equ2.gif?></graphic></alternatives></disp-formula>where <inline-formula id="IEq7"><alternatives><tex-math id="M17"><?equation-image-name M17.gif?><?equation-image-status READY?><?equation-image-md5 36f04c7e5e2a5b9b15acfacc2c09ff51?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/36f04c7e5e2a/M17.gif?>\documentclass[12pt]{minimal}
