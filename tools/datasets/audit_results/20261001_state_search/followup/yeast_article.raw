				\usepackage{amsfonts} 
				\usepackage{amssymb} 
				\usepackage{amsbsy}
				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$${T}_{{S-G}_{1}-M}=63$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M192"><mml:msub><mml:mrow><mml:mi>T</mml:mi></mml:mrow><mml:mrow><mml:msub><mml:mrow><mml:mi>S</mml:mi><mml:mo>−</mml:mo><mml:mi>G</mml:mi></mml:mrow><mml:mrow><mml:mn>1</mml:mn></mml:mrow></mml:msub><mml:mo>−</mml:mo><mml:mi>M</mml:mi></mml:mrow></mml:msub><mml:mo>=</mml:mo><mml:mn>63</mml:mn></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq86.gif"><?image-name 41467_2021_22689_Article_IEq86.gif?><?image-size 480?><?image-md5 4b3a5651e4a2fb4e58dfc2f95038cc2a?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 30?><?image-scaled-width 101?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/4b3a5651e4a2/41467_2021_22689_Article_IEq86.gif?><?thumb-name 41467_2021_22689_Article_IEq86.gif?><?thumb-size 480?><?thumb-md5 4b3a5651e4a2fb4e58dfc2f95038cc2a?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 30?><?thumb-scaled-width 101?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/4b3a5651e4a2/41467_2021_22689_Article_IEq86.gif?></inline-graphic></alternatives></inline-formula> min was computed as the median of the intervals measured in all binary traces between an off to on (<inline-formula id="IEq87"><alternatives><tex-math id="M193"><?equation-image-name M193.gif?><?equation-image-status READY?><?equation-image-md5 8010413cf2e8366d01ae089c16a6bf45?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/8010413cf2e8/M193.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
