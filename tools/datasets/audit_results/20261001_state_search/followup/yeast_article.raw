				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$V\in {{\mathbb{R}}}_{+}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M20"><mml:mi>V</mml:mi><mml:mo>∈</mml:mo><mml:msub><mml:mrow><mml:mi mathvariant="double-struck">R</mml:mi></mml:mrow><mml:mrow><mml:mo>+</mml:mo></mml:mrow></mml:msub></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq8.gif"><?image-name 41467_2021_22689_Article_IEq8.gif?><?image-size 307?><?image-md5 ec55976023f4202bcd6967f76e818228?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 54?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/ec55976023f4/41467_2021_22689_Article_IEq8.gif?><?thumb-name 41467_2021_22689_Article_IEq8.gif?><?thumb-size 307?><?thumb-md5 ec55976023f4202bcd6967f76e818228?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 54?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/ec55976023f4/41467_2021_22689_Article_IEq8.gif?></inline-graphic></alternatives></inline-formula> is the cell volume, <inline-formula id="IEq9"><alternatives><tex-math id="M21"><?equation-image-name M21.gif?><?equation-image-status READY?><?equation-image-md5 909584653f4f9452632d6074334ac7f9?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/909584653f4f/M21.gif?>\documentclass[12pt]{minimal}
				\usepackage{amsmath}
