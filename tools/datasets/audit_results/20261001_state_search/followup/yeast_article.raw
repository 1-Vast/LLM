				\usepackage{mathrsfs}
				\usepackage{upgreek}
				\setlength{\oddsidemargin}{-69pt}
				\begin{document}$$\vartheta$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M60"><mml:mi>ϑ</mml:mi></mml:math><inline-graphic xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="41467_2021_22689_Article_IEq25.gif"><?image-name 41467_2021_22689_Article_IEq25.gif?><?image-size 169?><?image-md5 c1c5052d630f8ebf97da536006fd59bd?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 29?><?image-scaled-width 14?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/c1c5052d630f/41467_2021_22689_Article_IEq25.gif?><?thumb-name 41467_2021_22689_Article_IEq25.gif?><?thumb-size 169?><?thumb-md5 c1c5052d630f8ebf97da536006fd59bd?><?thumb-image-server-status NEVER_LOAD?><?thumb-scaled-height 29?><?thumb-scaled-width 14?><?thumb-cloudpmc-urn urn:cdn:blobs/4187/8079375/c1c5052d630f/41467_2021_22689_Article_IEq25.gif?></inline-graphic></alternatives></inline-formula> to the input <inline-formula id="IEq26"><alternatives><tex-math id="M61"><?equation-image-name M61.gif?><?equation-image-status READY?><?equation-image-md5 08a3cd99b60c19ec73f7abdfa796a936?><?equation-image-cloudpmc-urn urn:cdn:blobs/4187/8079375/08a3cd99b60c/M61.gif?>\documentclass[12pt]{minimal}
