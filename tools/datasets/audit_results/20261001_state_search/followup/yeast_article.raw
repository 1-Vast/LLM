				\begin{document}$$\begin{array}{c}R\left(t\right){{\rm{e}}}^{j\psi \left(t\right)}=\frac{1}{N\left(t\right)}\mathop{\sum }\limits_{m=1}^{N\left(t\right)}{{\rm{e}}}^{j{\vartheta }_{m}\left(t\right)},\end{array}$$\end{document}</tex-math><mml:math xmlns:mml="http://www.w3.org/1998/Math/MathML" id="M218"><mml:mtable><mml:mtr><mml:mtd columnalign="center"><mml:mi>R</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced><mml:msup><mml:mrow><mml:mi mathvariant="normal">e</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi><mml:mi>ψ</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:msup><mml:mo>=</mml:mo><mml:mfrac><mml:mrow><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi>N</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:mfrac><mml:munderover accent="false" accentunder="false"><mml:mrow><mml:mo>∑</mml:mo></mml:mrow><mml:mrow><mml:mi>m</mml:mi><mml:mo>=</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mi>N</mml:mi><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:munderover><mml:msup><mml:mrow><mml:mi mathvariant="normal">e</mml:mi></mml:mrow><mml:mrow><mml:mi>j</mml:mi><mml:msub><mml:mrow><mml:mi>ϑ</mml:mi></mml:mrow><mml:mrow><mml:mi>m</mml:mi></mml:mrow></mml:msub><mml:mfenced close=")" open="("><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:mfenced></mml:mrow></mml:msup><mml:mo>,</mml:mo></mml:mtd></mml:mtr></mml:mtable></mml:math><graphic xmlns:xlink="http://www.w3.org/1999/xlink" position="anchor" orientation="portrait" xlink:href="41467_2021_22689_Article_Equ14.gif"><?image-name 41467_2021_22689_Article_Equ14.gif?><?image-size 1105?><?image-md5 c646ea57e52ed811e447d2463a021c64?><?image-image-server-status NEVER_LOAD?><?image-scaled-height 56?><?image-scaled-width 194?><?image-cloudpmc-urn urn:cdn:blobs/4187/8079375/c646ea57e52e/41467_2021_22689_Article_Equ14.g