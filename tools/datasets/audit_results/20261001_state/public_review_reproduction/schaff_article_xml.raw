nk" ext-link-type="doi" xlink:href="10.7717/peerj.453"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmcid" xlink:href="PMC4081273"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmid" xlink:href="25024921"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="google-scholar" xlink:href="journal=PeerJ&amp;title=scikit-image: image processing in Python&amp;author=S. van der Walt&amp;author=J.L. Schönberger&amp;author=J. Nunez-Iglesias&amp;author=F. Boulogne&amp;author=J.D. Warner&amp;volume=2&amp;publication_year=2014&amp;pmid=25024921&amp;doi=10.7717/peerj.453&amp;"/></mixed-citation></ref><ref id="bib87"><label>86.</label><mixed-citation id="optpVGdmyZMxN"><named-content content-type="citation-string">Dusa A.  2026. venn: Draw Venn Diagrams. R package version 1.12.3.<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://github.com/dusadrian/venn" ext-link-type="uri">https://github.com/dusadrian/venn</ext-link></named-content><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="google-scholar" xlink:href="Dusa A. 2026. venn: Draw Venn Diagrams. R package version 1.12.3.https://github.com/dusadrian/venn"/></mixed-citation></ref><ref id="bib84"><label>87.</label><mixed-citation id="sref84"><named-content content-type="citation-string">Subramanian A., Tamayo P., Mootha V.K., Mukherjee S., Ebert B.L., Gillette M.A., Paulovich A., Pomeroy S.L., Golub T.R., Lander E.S., Mesirov J.P. Gene set enrichment analysis: a knowledge-based approach for interpreting genome-wide expression profiles. Proc. Natl. Acad. Sci. USA. 2005;102:15545–15550. doi: 10.1073/pnas.0506580102.</named-content><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="doi" xlink:href="10.1073/pnas.0506580102"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmcid" xlink:href="PMC1239896"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmid" xlink:href="16199517"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="google-scholar" xlink:href="journal=Proc. Natl. Acad. Sci. USA&amp;title=Gene set enrichment analysis: a knowledge-based approach for interpreting genome-wide expression profiles&amp;author=A. Subramanian&amp;author=P. Tamayo&amp;author=V.K. Mootha&amp;author=S. Mukherjee&amp;author=B.L. Ebert&amp;volume=102&amp;publication_year=2005&amp;pages=15545-15550&amp;pmid=16199517&amp;doi=10.1073/pnas.0506580102&amp;"/></mixed-citation></ref></ref-list></sec></sec><sec id="_ad93_" xml:lang="en" sec-type="associated-data" disp-level="1"><title>Associated Data</title><sec id="_adsm93_" xml:lang="en" sec-type="supplementary-materials" disp-level="2"><title>Supplementary Materials</title><supplementary-material id="db_ds_supplementary-material1_reqid_" position="float"><?disp-level 2?><caption><title>Document S1. Figures S1–S10</title></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="mmc1.pdf" mimetype="application" mime-subtype="pdf"><?cloudpmc-path 9af0/13261651/97ee768c8c42/mmc1.pdf?><?cloudpmc-bucket app?><?size 7975393?></media></supplementary-material><supplementary-material id="db_ds_supplementary-material2_reqid_" position="float"><?disp-level 2?><caption><title>Table S1. Upregulated genes predictive of survival to each individual treatment, related to Figure 4</title></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="mmc2.xlsx" mimetype="application" mime-subtype="octet-stream"><?cloudpmc-path 9af0/13261651/15b59bc63eea/mmc2.xlsx?><?cloudpmc-bucket app?><?size 9269?></media></supplementary-material><supplementary-material id="db_ds_supplementary-material3_reqid_" position="float"><?disp-level 2?><caption><title>Table S2. FindMarkers results for each untreated cluster, related to Figure 4</title></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="mmc3.xlsx" mimetype="application" mime-subtype="octet-stream"><?cloudpmc-path 9af0/13261651/d641506aa33d/mmc3.xlsx?><?cloudpmc-bucket app?><?size 389641?></media></supplementary-material><supplementary-material id="db_ds_supplementary-material4_reqid_" position="float"><?disp-level 2?><caption><title>Table S3. GSEA on markers of untreated clusters, related to Figure 4</title></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="mmc4.xlsx" mimetype="application" mime-subtype="octet-stream"><?cloudpmc-path 9af0/13261651/322bfdcfc547/mmc4.xlsx?><?cloudpmc-bucket app?><?size 25814?></media></supplementary-material><supplementary-material id="db_ds_supplementary-material5_reqid_" position="float"><?disp-level 2?><caption><title>Table S4. Primers used for amplifying barcodes out of gDNA and 10× cDNA, related to STAR Methods</title></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="mmc5.xlsx" mimetype="application" mime-subtype="vnd.openxmlformats-officedocument.spreadsheetml.sheet"><?cloudpmc-path 9af0/13261651/44edb0c4dd40/mmc5.xlsx?><?cloudpmc-bucket app?><?size 9563?></media></supplementary-material><supplementary-material id="db_ds_supplementary-material6_reqid_" position="float"><?disp-level 2?><caption><title>Document S2. Article plus supplemental information</title></caption><media xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="mmc6.pdf" mimetype="application" mime-subtype="pdf"><?cloudpmc-path 9af0/13261651/e15dffd2dc50/mmc6.pdf?><?cloudpmc-bucket app?><?size 39649228?></media></supplementary-material></sec><sec id="_adda93_" xml:lang="en" sec-type="data-availability-statement" disp-level="2"><title>Data Availability Statement</title><p>scRNA-seq data are available at GEO: <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE279162" ext-link-type="uri"><ext-link xlink:href="https://ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE279162" ext-link-type="uri">GSE279162</ext-link></ext-link>. Code is available at Zenodo: <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://doi.org/10.5281/zenodo.13935305" ext-link-type="uri">https://doi.org/10.5281/zenodo.13935305</ext-link>. Raw and processed sequencing of gDNA barcodes is available at Figshare: <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://doi.org/10.6084/m9.figshare.25029338" ext-link-type="uri">https://doi.org/10.6084/m9.figshare.25029338</ext-link> and <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://doi.org/10.6084/m9.figshare.25024463" ext-link-type="uri">https://doi.org/10.6084/m9.figshare.25024463</ext-link>. FASTQ files of clonal barcodes amplified from 10× cDNA are available at Science Data Bank: <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://doi.org/10.57760/sciencedb.14654" ext-link-type="uri">https://doi.org/10.57760/sciencedb.14654</ext-link>. The barcode pipeline output is available at Science Data Bank: <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://doi.org/10.57760/sciencedb.14653" ext-link-type="uri">https://doi.org/10.57760/sciencedb.14653</ext-link>. Time-lapse imaging of resistance formation is available at Science Data Bank: <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://doi.org/10.57760/sciencedb.14740" ext-link-type="uri">https://doi.org/10.57760/sciencedb.14740</ext-link>. CD44 sort and treat imaging data are available at Science Data Bank: <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://doi.org/10.57760/sciencedb.14737" ext-link-type="uri">https://doi.org/10.57760/sciencedb.14737</ext-link>. NT5E sort and treat imaging data are available at Science Data Bank: <ext-link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="https://doi.org/10.57760/sciencedb.14724" ext-link-type="uri">https://doi.org/10.57760/sciencedb.14724</ext-link>. Any additional information required to reanalyze the data reported in this paper is available from the <xref rid="sec4.1" ref-type="sec">lead contact</xref> upon request.</p></sec></sec></body></article>