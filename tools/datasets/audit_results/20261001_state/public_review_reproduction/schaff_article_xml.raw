<ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmcid" xlink:href="PMC8540049"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmid" xlink:href="34696168"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="google-scholar" xlink:href="journal=Vaccines (Basel)&amp;title=MRNA-based cancer vaccines: A therapeutic strategy for the treatment of melanoma patients&amp;author=M. Bidram&amp;author=Y. Zhao&amp;author=N.G. Shebardina&amp;author=A.V. Baldin&amp;author=A.V. Bazhin&amp;volume=9&amp;publication_year=2021&amp;pages=1060&amp;pmid=34696168&amp;doi=10.3390/vaccines9101060&amp;"/></mixed-citation></ref><ref id="bib7"><label>7.</label><mixed-citation id="sref7"><named-content content-type="citation-string">Sayour E.J., Boczkowski D., Mitchell D.A., Nair S.K. Cancer mRNA vaccines: clinical advances and future opportunities. Nat. Rev. Clin. Oncol. 2024;21:489–500. doi: 10.1038/s41571-024-00902-1.</named-content><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="doi" xlink:href="10.1038/s41571-024-00902-1"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmid" xlink:href="38760500"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="google-scholar" xlink:href="journal=Nat. Rev. Clin. Oncol.&amp;title=Cancer mRNA vaccines: clinical advances and future opportunities&amp;author=E.J. Sayour&amp;author=D. Boczkowski&amp;author=D.A. Mitchell&amp;author=S.K. Nair&amp;volume=21&amp;publication_year=2024&amp;pages=489-500&amp;pmid=38760500&amp;doi=10.1038/s41571-024-00902-1&amp;"/></mixed-citation></ref><ref id="bib8"><label>8.</label><mixed-citation id="sref8"><named-content content-type="citation-string">Peterson C., Denlinger N., Yang Y. Recent advances and challenges in cancer immunotherapy. Cancers (Basel) 2022;14:3972. doi: 10.3390/cancers14163972.</named-content><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="doi" xlink:href="10.3390/cancers14163972"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmcid" xlink:href="PMC9406446"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmid" xlink:href="36010965"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="google-scholar" xlink:href="journal=Cancers (Basel)&amp;title=Recent advances and challenges in cancer immunotherapy&amp;author=C. Peterson&amp;author=N. Denlinger&amp;author=Y. Yang&amp;volume=14&amp;publication_year=2022&amp;pages=3972&amp;pmid=36010965&amp;doi=10.3390/cancers14163972&amp;"/></mixed-citation></ref><ref id="bib9"><label>9.</label><mixed-citation id="sref9"><named-content content-type="citation-string">Roy R., Singh S.K., Misra S. Advancements in cancer immunotherapies. Vaccines (Basel) 2022;11:59. doi: 10.3390/vaccines11010059.</named-content><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="doi" xlink:href="10.3390/vaccines11010059"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmcid" xlink:href="PMC9861770"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmid" xlink:href="36679904"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="google-scholar" xlink:href="journal=Vaccines (Basel)&amp;title=Advancements in cancer immunotherapies&amp;author=R. Roy&amp;author=S.K. Singh&amp;author=S. Misra&amp;volume=11&amp;publication_year=2022&amp;pages=59&amp;pmid=36679904&amp;doi=10.3390/vaccines11010059&amp;"/></mixed-citation></ref><ref id="bib10"><label>10.</label><mixed-citation id="sref10"><named-content content-type="citation-string">Sharma P., Hu-Lieskovan S., Wargo J.A., Ribas A. Primary, adaptive, and acquired resistance to cancer immunotherapy. Cell. 2017;168:707–723. doi: 10.1016/j.cell.2017.01.017.</named-content><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="doi" xlink:href="10.1016/j.cell.2017.01.017"/><ext-link xmlns:xlink="http://www.w3.org/1999/xlink" ext-link-type="pmcid" xl