": "43558eb6-1d38-4000-8d25-4b3b7803b634", "key": "HTS001.csv", "size": 3039472, "checksum": "md5:a5959a38166685707e840369ce34d74d", "links": {"self": "https://zenodo.org/api/records/18292967/files/HTS001.csv/content"}}, {"id": "9a8d9c7f-fc3f-49ef-a2e7-eef569e441fa", "key": "HTS031.csv", "size": 10789699, "checksum": "md5:973b12b7fe635088aa3b658568c18dc7", "links": {"self": "https://zenodo.org/api/records/18292967/files/HTS031.csv/content"}}], "swh": {}, "owners": [{"id": "1013057"}], "status": "published", "stats": {"downloads": 139, "unique_downloads": 108, "views": 107, "unique_views": 88, "version_downloads": 139, "version_unique_downloads": 108, "version_unique_views": 88, "version_views": 107}, "state": "done", "submitted": true}