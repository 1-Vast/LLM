function (cdfname, where, verbose = TRUE) 
{
    if (verbose) 
        print(paste("Attempting to locate", cdfname, "in specified environment"))
    if (exists(cdfname, inherits = FALSE, where = where)) 
        return(as.environment(get(cdfname, inherits = FALSE, 
            envir = where)))
    else {
        if (verbose) 
            print(paste("Specified environment does not contain", 
                cdfname))
        return(list(paste("Specified environment does not contain", 
            cdfname)))
    }
}
