iiif/record:21543796/sequence/default", "files": "https://zenodo.org/api/records/21543796/files", "media_files": "https://zenodo.org/api/records/21543796/media-files", "latest": "https://zenodo.org/api/records/21543796/versions/latest", "latest_html": "https://zenodo.org/records/21543796/latest", "versions": "https://zenodo.org/api/records/21543796/versions", "draft": "https://zenodo.org/api/records/21543796/draft", "access_links": "https://zenodo.org/api/records/21543796/access/links", "access_grants": "https://zenodo.org/api/records/21543796/access/grants", "access_users": "https://zenodo.org/api/records/21543796/access/users", "access_request": "https://zenodo.org/api/records/21543796/access/request", "access": "https://zenodo.org/api/records/21543796/access", "communities": "https://zenodo.org/api/records/21543796/communities", "communities-suggestions": "https://zenodo.org/api/records/21543796/communities-suggestions", "request_deletion": "https://zenodo.org/api/records/21543796/request-deletion", "file_modification": "https://zenodo.org/api/records/21543796/file-modification", "quota_increase": "https://zenodo.org/api/records/21543796/quota-increase", "requests": "https://zenodo.org/api/records/21543796/requests"}, "updated": "2026-07-25T04:25:57.715151+00:00", "recid": "21543796", "revision": 4, "files": [{"id": "de8f43af-d4c9-4008-b57e-87c6ea4ab947", "key": "Commented_Codes_full.zip", "size": 1215917722, "checksum": "md5:1402d36567b5d5037707d8eb843a249c", "links": {"self": "https://zenodo.org/api/records/21543796/files/Commented_Codes_full.zip/content"}}], "swh": null, "owners": [{"id": "1776895"}], "status": "published", "stats": {"downloads": 0, "unique_downloads": 0, "views": 12, "unique_views": 5, "version_downloads": 0, "version_unique_downloads": 0, "version_unique_views": 5, "version_views": 12}, "state": "done", "submitted": true}, {"created": "2018-01-16T23:08:38.919201+00:00", "modified": "2024-08-02T22:46:34.573117+00:00", "id": 1089251, "conceptrecid": "1089250", "doi": "10.5281/zenodo.1089251", "conceptdoi": "10.5281/zenodo.1089250", "doi_url": "https://doi.org/10.5281/zenodo.1089251", "metadata": {"title": "Measurement of Steady Streaming from an Oscillating Bubble Using Particle Image Velocimetry", "doi": "10.5281/zenodo.1089251", "publication_date": "2013-11-06", "description": "<p>Steady streaming flow fields induced by a 500 mm bubble oscillating at 12 kHz were measured using microscopic particle image velocimetry (PIV). The accuracy of velocity measurement using a micro PIV system was checked by comparing the measured velocity fields with the theoretical velocity profiles in fully developed laminar flow. The steady streaming flow velocities were measured in the sagittal plane of the bubble attached on the wall. Measured velocity fields showed upward jet flow with two symmetric counter-rotating vortices, and the maximum streaming velocity was about 12 mm/s, which was within the velocity ranges measured by other researchers. The measured streamlines were compared with the analytical solution, and they also showed a reasonable agreement.</p>", "access_right": "open", "creators": [{"name": "Yongseok Kwon", "affiliation": null}, {"name": "Woowon Jeong", "affiliation": null}, {"name": "Eunjin Cho", "affiliation": null}, {"name": "Sangkug Chung", "affiliation": null}, {"name": "Kyehan Rhee", "affiliation": null}], "keywords": ["Oscillating bubble", "Particle-Image-Velocimetry microstreaming."], "version": "9996686", "references": ["E. C. Unger, T. O. Matsunaga, T. McCreery, P. Schumann, R. Sweitzer and R. Quigley, \"Therapeutic applications of microbubbles,\" Eur. J. Radiol., vol. 42, pp. 160-168, May. 2002.", "K. Ferrara, R. Pollard and M. Borden, \"Ultrasound microbubble contrast agents: fundamentals and application to gene and drug delivery,\" Annu. Rev. Biomed. Eng., vol. 9, pp. 415-447, Aug. 2007.", "N. McDannold, N. Vykhodtseva and K. Hynynen, \"Blood-brain barrier disruption induced by focused ultrasound and circulating preformed microbubbles appears to be characterized by the mechanical index,\" Ultrasound Med. Biol., vol. 34, pp. 834-840, May. 2008.", "H. Andersson and A. Van den Berg, \"Microfluidic devices for cellomics: a review,\" Sens. Actuators B: Chem., vol. 92, pp. 315-325, Jul. 2003.", "T. Franke, A. R. Abate, D. A. Weitz and A. Wixforth, \"Surface acoustic wave (SAW) directed droplet flow in microfluidics for PDMS devices,\" Lab on a Chip, vol. 9, pp. 2625-2627, Jun. 2009.", "W. Nyborg, \"Acoustic streaming,\" Physical Acoustics, vol. 2, pp. 265-330, 1965.", "S. A. Elder, \"Cavitation microstreaming,\" J. Acoust. Soc. Am., vol. 31, pp. 54-64, 1959.", "R. H. Liu, J. Yang, M. Z. Pindera, M. Athavale and P. Grodzinski, \"Bubble-induced acoustic micromixing,\" Lab on a Chip, vol. 2, pp. 151-157, Jul. 2002.", "P. Marmottant and S. Hilgenfeldt, \"Controlled vesicle deformation and lysis by single oscillating bubbles,\" Nature, vol. 423, pp. 153-156, May. 2003. \n[10]\tC. Wang, S. V. Jalikop and S. Hilgenfeldt, \"Efficient manipulation of microparticles in bubble streaming flows,\" Biomicrofluidics, vol. 6, pp. 012801, Mar. 2012. \n[11]\tP. Tho, R. Manasseh and A. Ooi, \"Cavitation microstreaming patterns in single and multiple bubble systems,\" J. Fluid Mech., vol. 576, pp. 191-233, Apr. 2007. \n[12]\tS. J. Lighthill, \"Acoustic streaming,\" J. Sound Vibrat., vol. 61, pp. 391-418, Dec. 1978."], "language": "eng", "resource_type": {"title": "Journal article", "type": "publication", "subtype": "article"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "waset"}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "1089250"}}]}}, "title": "Measurement of Steady Streaming from an Oscillating Bubble Using Particle Image Velocimetry", "links": {"self": "https://zenodo.org/api/records/1089251", "self_html": "https://zenodo.org/records/1089251", "preview_html": "https://zenodo.org/records/1089251?preview=1"