# MAESTRO provider configuration. Copy to .env and fill in real values.
# .env is git-ignored; never commit real keys. Values are read from the process
# environment first, then from this file.

# --- Text and vision model (required) -------------------------------------
# An OpenAI-compatible Chat Completions endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# --- Typed decision model (optional) --------------------------------------
# TypeSafe Jev answers typed questions (yes/no, choice, score) with calibrated
# probabilities instead of text. When these are absent the decision critic is
# simply disabled and the agent loop is unchanged.
# TYPESAFE_ENDPOINT may be the base URL; the evaluate path is appended.
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai
TYPESAFE_MODEL=
TYPESAFE_TIMEOUT_SECONDS=30

# --- Run records (optional) -----------------------------------------------
# Relative paths are read against the workspace. Defaults to log/20260910.
MAESTRO_LOG_DIRECTORY=
