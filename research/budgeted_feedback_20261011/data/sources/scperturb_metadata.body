{"created": "2023-10-27T11:45:06.029027+00:00", "modified": "2024-07-11T00:51:42.179089+00:00", "id": 10047269, "conceptrecid": "10047268", "doi": "10.5281/zenodo.10047269", "conceptdoi": "10.5281/zenodo.10047268", "doi_url": "https://doi.org/10.5281/zenodo.10047269", "metadata": {"title": "Review on Steel Reinforcements Replaced by Bamboo and GFRP Rods in Concrete Slab", "doi": "10.5281/zenodo.10047269", "publication_date": "2023-10-27", "description": "<p>Currently fiber-reinforced polymers are increasing in importance in the market due to their lightness,</p><p>high strength-to-weight ratio, high durability, stiffness, damping properties, flexural strength,</p><p>abrasion, impact and fire resistance. They have been used as a replacement for traditional steel bars</p><p>due to their excellent electrochemical corrosion resistance properties. These polymers have become</p><p>important materials for maintaining and strengthening existing infrastructures. In recent decades,</p><p>there has been a growing interest in the use of bamboo in construction, mainly due to its durability.</p><p>The mechanical properties of bamboo, its availability in developing regions, low cost, lightness and</p><p>short growth cycle have led to its empirical use as reinforcement in concrete structures. This article</p><p>provides an overview of the behaviour of GFRP and bamboo reinforced plates, their advantages and</p><p>applications.</p>", "access_right": "open", "creators": [{"name": "Nivetha R", "affiliation": null}, {"name": "Seethalakshmi T", "affiliation": null}], "dates": [{"type": "issued"}], "language": "eng", "resource_type": {"title": "Publication", "type": "publication"}, "journal": {"issue": "5", "pages": "222-226", "title": "International Journal of Scientific Research and Engineering Development", "volume": "6"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "10047268"}}]}}, "title": "Review on Steel Reinforcements Replaced by Bamboo and GFRP Rods in Concrete Slab", "links": {"self": "https://zenodo.org/api/records/10047269", "self_html": "https://zenodo.org/records/10047269", "preview_html": "https://zenodo.org/records/10047269?preview=1", "doi": "https://doi.org/10.5281/zenodo.10047269", "self_doi": "https://doi.org/10.5281/zenodo.10047269", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.10047269", "reserve_doi": "https://zenodo.org/api/records/10047269/draft/pids/doi", "parent": "https://zenodo.org/api/records/10047268", "parent_html": "https://zenodo.org/records/10047268", "parent_doi": "https://doi.org/10.5281/zenodo.10047268", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.10047268", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:10047269/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:10047269/sequence/default", "files": "https://zenodo.org/api/records/10047269/files", "media_files": "https://zenodo.org/api/records/10047269/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:10047269:IJSRED-V6I5P27.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:10047269:IJSRED-V6I5P27.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:10047269:IJSRED-V6I5P27.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:10047269:IJSRED-V6I5P27.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:10047269:IJSRED-V6I5P27.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:10047269:IJSRED-V6I5P27.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/10047269/versions/latest", "latest_html": "https://zenodo.org/records/10047269/latest", "versions": "https://zenodo.org/api/records/10047269/versions", "draft": "https://zenodo.org/api/records/10047269/draft", "access_links": "https://zenodo.org/api/records/10047269/access/links", "access_grants": "https://zenodo.org