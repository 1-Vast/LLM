<h3>Ground truth&nbsp;<a href="http://bbbc.broadinstitute.org/benchmarking#Biological"><div class="media media--type-image media--view-mode-small">
  
  
            <div data-quickedit-entity-id="media/2601" class="field field--name-field-media-image field--type-image field--label-hidden field--mode-small field--item">    <picture>
                  <source srcset="/files/styles/width_150/public/files/bbbc/files/button_b_11.webp?itok=yuxXMgc8 1x, /files/styles/width_300/public/files/bbbc/files/button_b_11.webp?itok=LfgBYy1K 2x" media="(min-width: 0px)" type="image/webp">
              <source srcset="/files/styles/width_150/public/files/bbbc/files/button_b_11.png?itok=yuxXMgc8 1x, /files/styles/width_300/public/files/bbbc/files/button_b_11.png?itok=LfgBYy1K 2x" media="(min-width: 0px)" type="image/png">
