    <h1 class="page-header page-title">
<span>Human MCF7 cells – compound-profiling experiment</span>
</h1>

  <article class="page full clearfix">

  
    

  
  <div class="content">
    
            <div class="prose field field--name-body field--type-text-with-summary field--label-hidden field--mode-full field--item"><p>Accession number <a href="/bbbc/BBBC021" title>BBBC021</a> · Version 1</p>

<h3>Example Images</h3>

<table border="1" cellpadding="1" cellspacing="1" style="width:915px;">
	<tbody>
		<tr>
			<td><img alt="Actin disrupter" height="223" src="https://data.broadinstitute.org/bbbc/BBBC021/actin-disrupter.png" style="width:300px;height:223px;" width="300"></td>
			<td><img alt="Aurora kinase inhibitor" height="223" src="https://data.broadinstitute.org/bbbc/BBBC021/aurora-kinase-inhibitor.png" style="width:300px;height:223px;" width="300"></td>
			<td><img alt="Monoaster" height="223" src="https://data.broadinstitute.org/bbbc/BBBC021/monoaster.png" style="width:300px;height:223px;" width="300"></td>
